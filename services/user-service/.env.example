APP_NAME="Certix Passport - User Service"
APP_VERSION="0.1.0"
HOST="127.0.0.1"
PORT=8001
DEBUG=true

JWT_SECRET_KEY=your_generated_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/<POSTGRES_DB>